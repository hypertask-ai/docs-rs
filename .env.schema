# Declared environment for this project. Checked in; no values here.
# Declare every variable the app reads. Mark secrets @sensitive. Put local
# values in .env.local (gitignored). Validate with `pnpm env:check`, and run
# commands with injected values via `pnpm exec varlock run -- <cmd>`.
# Mischief's Worker keys come from apps/site/.env.schema. This file owns
# the keys it omits from that import.
#
# @currentEnv=$APP_ENV
# @defaultRequired=false
# @defaultSensitive=true
# @import(./apps/site/.env.schema, omit=[EVENTS_ENABLED, EVENTS_IDENTITY_MODE, EVENTS_SINK_TOKEN, INTEREST_OPERATOR_TOKEN])
# ---

# Example non-secret setting. Replace with the project's real variables.
# @type=enum(development, test, production)
# @sensitive=false
APP_ENV=development

# Local learning store. Unset uses the operator home directory.
# @type=string
# @sensitive=false
RAT_LEARN_DIRECTORY=

# Public deck endpoint. Progress never leaves the local adapter.
# @type=url
# @sensitive=false
RAT_LEARN_ORIGIN=

# Turbo sets this only inside a task; the content preparation script skips duplicate generation there.
# @type=string
# @sensitive=false
TURBO_HASH=

# Set by portless when `pnpm dev` runs the web app (http://rat-stack.localhost:1355).
# The web dev composition passes it to Better Auth as baseURL.
# @type=url
# @sensitive=false
PORTLESS_URL=

# Agent intake uses its own credential; unset keeps agent signup off.
# @type=string
# @sensitive=true
DROVR_AGENT_INTAKE_CREDENTIAL=

# Optional scorer credential; unset uses code-only abuse scoring.
# @type=string
# @sensitive=true
TYPESAFE_API_KEY=

# Operator-only application reader and intake CLI authorization.
# @type=string
# @sensitive=true
INTEREST_OPERATOR_TOKEN=

# Verified destination for workshop email forwarding, required outside dev.
# @required=forEnv(production)
# @type=string
# @sensitive=true
EMAIL_FORWARD_TO=

# Deployment must select a named Alchemy profile.
# @required=forEnv(production)
# @sensitive=false
ALCHEMY_PROFILE=

# Full checkout commit attached to an isolated PR preview.
# @type=string
# @sensitive=false
PREVIEW_COMMIT=

# Public canonical origin for the isolated reader preview.
# @type=url
# @sensitive=false
PREVIEW_ORIGIN=

# Enable phone approval and feedback-only credentials. Off retains only the database and signing-secret foundation.
# @type=boolean
# @sensitive=false
AUTH_ENABLED=false

# Native Effect tracing is opt-in. Cloudflare owns head sampling and export.
# @type=boolean
# @sensitive=false
TRACES_ENABLED=false

# Sample one percent of enabled invocations. The runtime accepts 0 through 1.
# @type=number
# @sensitive=false
TRACES_HEAD_SAMPLING_RATE=0.01

# Keep the production analytics footprint explicit.
# @required=forEnv(production)
# @type=boolean
# @sensitive=false
EVENTS_ENABLED=

# @required=forEnv(production)
# @type=enum(daily, persistent)
# @sensitive=false
EVENTS_IDENTITY_MODE=

# @required=forEnv(production)
# @sensitive=true
EVENTS_SINK_TOKEN=

# Content propagation retry budget in milliseconds. The exported driver default is 120000.
# @type=number
# @sensitive=false
DEPLOY_CONTENT_VERSION_DEADLINE_MS=120000

# Live Worker deployment listing can lag a successful full-cutover upload.
# @type=number
# @sensitive=false
DEPLOY_WORKER_VERSION_DEADLINE_MS=120000

# UTC windows when production deploys must not apply, as JSON. HH:MM times repeat daily: [{"start":"14:00","end":"15:30"}]. :MM times repeat hourly: [{"start":":59","end":":01"}]. Empty means no windows.
# @type=string
# @sensitive=false
DEPLOY_QUIET_WINDOWS=

# How long deployProd may wait for a quiet window to end before it refuses. 0 refuses at once; the maximum is 3600000.
# @type=number
# @sensitive=false
DEPLOY_QUIET_WINDOW_MAX_WAIT_MS=0

# Live docs settings, names only, from hypertask-ai/docs before the Rat Stack move (HTPR-9182).
# The GitHub side keeps these names on the new repository. An operator sets the
# values through the stack-key flow; no value is written here.
#
# Deploy token for the hypertask-docs Pages project and the docs MCP Worker.
# @type=string
# @sensitive=true
CLOUDFLARE_API_TOKEN=

# Agent login for the scheduled reference refresh.
# @type=string
# @sensitive=true
DOCS_REFS_HT_TOKEN=

# Push key for the scheduled reference refresh commit.
# @type=string
# @sensitive=true
DOCS_REFS_PUSH_KEY=

# Release switch for the scheduled reference refresh.
# @type=string
# @sensitive=false
DOCS_REFS_ENABLED=

# Publish switch for regenerated references.
# @type=string
# @sensitive=false
DOCS_REFS_PUBLISH=

# Agent the reference refresh token must belong to.
# @type=string
# @sensitive=false
DOCS_REFS_AGENT_ID=

# Approved docs MCP Worker content for a release.
# @type=string
# @sensitive=false
DOCS_MCP_APPROVED_SHA=

# GitHub token for the docs MCP Worker content reads.
# @type=string
# @sensitive=true
GITHUB_TOKEN=

# Shared login secret between the docs MCP Worker and the app.
# @type=string
# @sensitive=true
JWT_SECRET=

# Pages deploy hook the docs MCP Worker calls.
# @type=url
# @sensitive=true
CF_PAGES_DEPLOY_HOOK=

# Repository owner the docs MCP Worker reads content from.
# @type=string
# @sensitive=false
GITHUB_OWNER=

# Repository the docs MCP Worker reads content from.
# @type=string
# @sensitive=false
GITHUB_REPO=

# Branch the docs MCP Worker reads content from.
# @type=string
# @sensitive=false
GITHUB_BRANCH=

# Docs content directory inside that repository.
# @type=string
# @sensitive=false
DOCS_BASE_PATH=

# Astro config path the docs MCP Worker reads.
# @type=string
# @sensitive=false
CONFIG_FILE_PATH=

# Editors allowed to write through the docs MCP Worker. The live hold keeps this empty.
# @type=string
# @sensitive=false
DOCS_EDITOR_USER_IDS=

# Agent login the reference scripts use for the Hypertask MCP.
# @type=string
# @sensitive=true
HYPERTASK_MCP_TOKEN=

# Live docs origin the nightly script reads.
# @type=url
# @sensitive=false
DOCS_SITE_URL=

# Agent id the reference refresh must match.
# @type=string
# @sensitive=false
EXPECTED_AGENT_ID=
