{
  "name": "@hypertask-docs/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#built-app": {
      "types": "./src/app.ts",
      "default": "./dist/app.js"
    },
    "#built-node-content": {
      "types": "./src/node-content.ts",
      "default": "./dist/node-content.js"
    }
  },
  "exports": {
    "./node-content": {
      "types": "./src/node-content.ts",
      "import": "./src/node-content.ts",
      "default": "./src/node-content.ts"
    },
    "./capabilities": {
      "types": "./src/capabilities/index.ts",
      "import": "./src/capabilities/index.ts",
      "default": "./src/capabilities/index.ts"
    },
    "./preview-rpc-worker": {
      "types": "./src/preview-rpc-worker.ts",
      "import": "./src/preview-rpc-worker.ts",
      "default": "./src/preview-rpc-worker.ts"
    },
    "./rpc-worker": {
      "types": "./src/rpc-worker.ts",
      "import": "./src/rpc-worker.ts",
      "default": "./src/rpc-worker.ts"
    },
    "./rat.css": "./src/rat.css",
    "./rat-icons": {
      "types": "./src/rat-icons.ts",
      "import": "./src/rat-icons.ts",
      "default": "./src/rat-icons.ts"
    }
  },
  "scripts": {
    "generate": "node scripts/generate-content.ts",
    "typecheck": "node scripts/prepare-content.ts && effect-tsrs diagnostics --project tsconfig.json --strict --type-check && pnpm run --silent typecheck:doc-fences && pnpm run --silent startup:check",
    "typecheck:doc-fences": "effect-tsrs diagnostics --project tsconfig.doc-fences.json --strict --type-check",
    "typecheck:tsc": "node scripts/prepare-content.ts && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.doc-fences.json && pnpm run --silent startup:check",
    "typecheck:fast": "tsrs --noEmit -p tsconfig.json",
    "startup:check": "node scripts/startup-budget.ts",
    "startup:profile": "pnpm run --silent generate && pnpm run --silent startup:check && wrangler check startup --worker dist/startup/worker.bundle --outfile dist/startup/worker.cpuprofile",
    "test": "vitest run",
    "build": "node scripts/prepare-content.ts && tsc -p tsconfig.build.json",
    "build:check-direct": "node scripts/check-direct-build.ts",
    "check": "pnpm run typecheck",
    "pretest": "pnpm run --silent build"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@hypertask-docs/auth": "workspace:*",
    "@hypertask-docs/capability": "workspace:*",
    "@hypertask-docs/core": "workspace:*",
    "@hypertask-docs/crash": "workspace:*",
    "@hypertask-docs/database": "workspace:*",
    "@hypertask-docs/events": "workspace:*",
    "@hypertask-docs/flags": "workspace:*",
    "@hypertask-docs/intake-live": "workspace:*",
    "@hypertask-docs/learn": "workspace:*",
    "@hypertask-docs/lore": "workspace:*",
    "@hypertask-docs/subscriber-delivery": "workspace:*",
    "alchemy": "2.0.0-beta.85",
    "effect": "4.1.2"
  },
  "devDependencies": {
    "@alchemy.run/test": "2.0.0-beta.85",
    "@effect/platform-browser": "4.1.2",
    "@effect/platform-node": "4.1.2",
    "@effect/vitest": "4.1.2",
    "@foldkit/markdown": "0.15.0",
    "@hypertask-docs/code-snippets": "workspace:*",
    "@resvg/resvg-js": "2.6.2",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "@types/unist": "3.0.3",
    "foldkit": "0.170.0",
    "htmlparser2": "12.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "satori": "0.63.2",
    "typescript": "7.0.2",
    "unified": "11.0.5",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
