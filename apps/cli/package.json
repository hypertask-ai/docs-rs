{
  "name": "@hypertask-docs/cli",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "rat-stack": "./bin/rat-stack"
  },
  "type": "module",
  "scripts": {
    "typecheck": "effect-tsrs diagnostics --project tsconfig.json --strict --type-check",
    "typecheck:tsc": "tsc --noEmit -p tsconfig.json",
    "typecheck:fast": "tsrs --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json && vite build -c ratstack.config.ts",
    "cli": "pnpm run --silent build && node dist/cli.js",
    "check": "pnpm run typecheck",
    "pretest": "pnpm run --silent build",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.2",
    "@hypertask-docs/capability": "workspace:*",
    "@hypertask-docs/core": "workspace:*",
    "@hypertask-docs/devtools": "workspace:*",
    "@hypertask-docs/learn": "workspace:*",
    "effect": "4.1.2"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.2",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
